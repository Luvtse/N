# Nidus backend — environment template.
# Copy to .env (gitignored) and fill in real values per environment.
# Every FEATURE_* flag defaults to false when unset (Global Rule 6):
# features stay off in production until explicitly enabled here or via env.

# ---------------------------------------------------------------------------
# Feature flags (kill switches). Set to "true" only in the environments where
# the paired feature is verified. See config/feature-flags/flags.json for the
# client-side registry and per-flag kill-switch documentation.
# ---------------------------------------------------------------------------
FEATURE_AUTONOMOUS_VEHICLES=false
FEATURE_DRONE_DELIVERY=false
FEATURE_INTERNAL_LEDGER=false
FEATURE_FEDERATED_LEARNING=false
FEATURE_AR_NAVIGATION=false
FEATURE_VOICE_COMMANDS=false
FEATURE_NOTIFICATIONS=false
FEATURE_CHAT=false
FEATURE_CHAT_TRANSLATION=false
FEATURE_MASKED_CALLING=false
FEATURE_PRE_SELFIE=false

# ---------------------------------------------------------------------------
# §1.4 Notifications substrate
# ---------------------------------------------------------------------------
# FCM legacy HTTP endpoint + server key (direct-push path used by FcmAdapter;
# leave empty to disable FCM dispatch — in-app and email channels keep working).
FCM_LEGACY_ENDPOINT=
FCM_SERVER_KEY=
# Transactional email: SendGrid API key + verified sender address.
SENDGRID_API_KEY=
NOTIFICATIONS_EMAIL_FROM=no-reply@nidaw.example

# ---------------------------------------------------------------------------
# §2.1 Chat translation (optional; only read when FEATURE_CHAT_TRANSLATION=true)
# Self-hosted LibreTranslate instance — no API key by design (OSS provider).
CHAT_TRANSLATE_ENDPOINT=

# ---------------------------------------------------------------------------
# §2.2 Masked calling (only read when FEATURE_MASKED_CALLING=true; the server
# fails loudly at boot if the flag is on but any required var below is empty)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEPHONY_TWILIO_SERVICE_SID=
# Comma-separated pool of proxy numbers assigned to Interactive Proxy sessions.
TELEPHONY_PROXY_NUMBERS=
# Optional: Twilio number used for SMS fallbacks (chat invite texts, etc.).
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# §2.3 Pre-selfie verification (only read when FEATURE_PRE_SELFIE=true)
# ---------------------------------------------------------------------------
# Directory the LocalFileStorage adapter writes uploaded selfies into.
SELFIE_STORAGE_DIR=/var/lib/nidus/selfies
# Public base URL served in front of SELFIE_STORAGE_DIR (CDN or reverse proxy).
# Signed URLs are minted as ${SELFIE_PUBLIC_BASE_URL}/{id}?exp=..&sig=..
SELFIE_PUBLIC_BASE_URL=
# HMAC secret for signing selfie redemption URLs. Generate with:
#   openssl rand -hex 32
# Rotating this value instantly invalidates every outstanding signed link.
SELFIE_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Other integrations referenced from main.go
# ---------------------------------------------------------------------------
AWS_REGION=
FRAUD_ML_BASE_URL=
FRAUD_ML_TOKEN=
LEDGER_ESCROW_WINDOW_HOURS=
LEDGER_REBUILD_APPLY=
LEDGER_REPORT_KEY=
