        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-12T00:00:00Z",
          "expires": null,
          "description": "§2.1 in-app rider<->driver chat (/api/v1/chat REST + chat.ride.{rideId} WS topic). Kill switch: FEATURE_CHAT=false (env) unmounts the routes at next boot; persisted messages remain in Postgres. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set the paired FEATURE_* env var to false and redeploy; routes unmount at next boot. Persisted rows remain queryable directly."
        }
      },
      "chat_translation": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-12T00:00:00Z",
          "expires": null,
          "description": "§2.1 optional machine translation for chat (LibreTranslate via CHAT_TRANSLATE_ENDPOINT). Requires chat=true. Kill switch: FEATURE_CHAT_TRANSLATION=false (env) or unset CHAT_TRANSLATE_ENDPOINT; messages then ship untranslated with translated_from=null and the UI hides translation affordances — never a fake translation. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set the paired FEATURE_* env var to false and redeploy; routes unmount at next boot. Persisted rows remain queryable directly."
        }
      },
      "masked_calling": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-13T00:00:00Z",
          "expires": null,
          "description": "§2.2 masked/anonymous calling (GET /api/v1/telephony/rides/{rideId}/contact, Twilio Proxy adapter). Kill switch: FEATURE_MASKED_CALLING=false (env) unmounts routes and stops new proxy provisioning at next boot; existing sessions expire by TTL. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_MASKED_CALLING=false and redeploy; the route group is not mounted and the sweeper does not start. Live proxy sessions age out via their own TTL."
        }
      },
      "pre_selfie": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-13T00:00:00Z",
          "expires": null,
          "description": "§2.3 pre-selfie verification (POST /api/v1/driver/rides/{rideId}/pre-selfie + signed-URL redemption GET /api/v1/selfies/{id}). Kill switch: FEATURE_PRE_SELFIE=false (env) unmounts routes at next boot; driver_pre_selfie_url is omitted from ride DTOs and the rider card shows the honest 'not sent' state. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_PRE_SELFIE=false and redeploy; upload/redemption routes are not mounted and the DTO field is dropped. Stored images remain on disk/object storage for compliance review."
        }
      },
      "cash_payment": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-15T00:00:00Z",
          "expires": null,
          "description": "§3.1 cash payment option (cash in GET/POST /api/v1/payment-methods, cash ride requests, POST /api/v1/nidus/rides/{rideId}/confirm-cash-collection). Kill switch: FEATURE_CASH_PAYMENT=false (env) stops accepting new cash requests and unmounts the confirm endpoint at next boot; rides already pending_cash_collection remain collectible via the wallet fallback so no driver is stranded. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_CASH_PAYMENT=false and redeploy; the confirm endpoint returns 404 (unmounted) and RequestRide rejects payment_method_type=cash with a validation error. Existing pending_cash_collection rows are untouched in Postgres."
        }
      },
      "promotions": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-15T00:00:00Z",
          "expires": null,
          "description": "§3.2 promo codes & coupons (POST /api/v1/promotions/redeem pre-ride validation + projected discount, GET /api/v1/promotions/mine active-code listing, automatic discount application at receipt time, promo.granted notification fan-out). Kill switch: FEATURE_PROMOTIONS=false (env) unmounts both routes at next boot; redemption rows remain in Postgres and previously-granted codes fail validation with an explicit 'promotions unavailable' error rather than silently charging full fare. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_PROMOTIONS=false and redeploy; redeem/mine routes are not mounted and receipt-time application is skipped (discount_applied stays persisted on completed rides for accounting). No user-visible fake discount states are shown while off."
        }
      }
