# ============================================================================
# NIDAW Staging Environment Configuration
# ============================================================================
# This file contains staging-specific environment variables.
# Staging should mirror production as closely as possible.
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=staging
REGION=us-east-1
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_PROFILING=false
ENABLE_DEBUG=false

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DB_HOST=nidaw-staging-postgres.xxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=nidaw_staging
DB_PASSWORD=${STAGING_DB_PASSWORD}
DB_NAME=nidaw_staging
DB_SSLMODE=require
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s
DB_QUERY_TIMEOUT=30s
DB_LOG_LEVEL=warn

# ----------------------------------------------------------------------------
# TIMESCALEDB
# ----------------------------------------------------------------------------
TIMESCALE_HOST=nidaw-staging-timescale.xxx.us-east-1.rds.amazonaws.com
TIMESCALE_PORT=5432
TIMESCALE_USER=nidaw_staging
TIMESCALE_PASSWORD=${STAGING_TIMESCALE_PASSWORD}
TIMESCALE_DB=nidaw_staging_timeseries

# ----------------------------------------------------------------------------
# REDIS
# ----------------------------------------------------------------------------
REDIS_URL=redis://nidaw-staging-redis.xxx.cache.amazonaws.com:6379
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ----------------------------------------------------------------------------
# KAFKA
# ----------------------------------------------------------------------------
KAFKA_BROKERS=b-1.nidaw-staging-kafka.xxx.us-east-1.ms.amazonaws.com:9092,b-2.nidaw-staging-kafka.xxx.us-east-1.ms.amazonaws.com:9092,b-3.nidaw-staging-kafka.xxx.us-east-1.ms.amazonaws.com:9092
SCHEMA_REGISTRY_URL=http://nidaw-staging-schema-registry:8081
KAFKA_CONSUMER_GROUP=nidaw-backend-staging
KAFKA_PRODUCER_TIMEOUT=10s
KAFKA_CONSUMER_TIMEOUT=30s
KAFKA_RETRIES=3

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
JWT_SECRET=${STAGING_JWT_SECRET}
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
JWT_ISSUER=nidaw-staging
JWT_AUDIENCE=nidaw-client-staging
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# PAYMENTS (Ethiopian rails: Telebirr, Chapa, M-Pesa Ethiopia)
# Credentials sourced from each provider's developer portal.
# ----------------------------------------------------------------------------
PAYMENT_ACTIVE_PROVIDER=__REPLACE_ME__
CHAPA_SECRET_KEY=__REPLACE_ME__
CHAPA_PUBLIC_KEY=__REPLACE_ME__
CHAPA_WEBHOOK_HASH=__REPLACE_ME__
TELEBIRR_CLIENT_ID=__REPLACE_ME__
TELEBIRR_CLIENT_SECRET=__REPLACE_ME__
TELEBIRR_PRIVATE_KEY=__REPLACE_ME__
TELEBIRR_PUBLIC_KEY=__REPLACE_ME__
MPESA_CONSUMER_KEY=__REPLACE_ME__
MPESA_CONSUMER_SECRET=__REPLACE_ME__
MPESA_SHORTCODE=__REPLACE_ME__
MPESA_PASSKEY=__REPLACE_ME__

# ----------------------------------------------------------------------------
# EXTERNAL APIS
# ----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=${STAGING_GOOGLE_MAPS_API_KEY}
TWILIO_ACCOUNT_SID=${STAGING_TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${STAGING_TWILIO_AUTH_TOKEN}
TWILIO_FROM_NUMBER=+15559876543
SENDGRID_API_KEY=${STAGING_SENDGRID_API_KEY}
FIREBASE_PROJECT_ID=nidaw-staging
FIREBASE_PRIVATE_KEY=${STAGING_FIREBASE_PRIVATE_KEY}
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-staging@nidaw-staging.iam.gserviceaccount.com

# ----------------------------------------------------------------------------
# ML PLATFORM
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://nidaw-staging-mlflow:5000
FEATURE_STORE_PATH=/app/ml/feature_store
MODEL_REGISTRY_URL=http://nidaw-staging-mlflow:5000
ML_INFERENCE_TIMEOUT=5s
FEAST_SERVING_URL=http://nidaw-staging-feast:6566

# ----------------------------------------------------------------------------
# API GATEWAY
# ----------------------------------------------------------------------------
KONG_PROXY_URL=https://staging-api.nidaw.com
KONG_ADMIN_URL=http://nidaw-staging-kong-admin:8001
KONG_STATUS_URL=http://nidaw-staging-kong-status:8100

# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------
API_BASE_URL=https://staging-api.nidaw.com
WS_BASE_URL=wss://staging-api.nidaw.com/ws
FRONTEND_URL=https://staging-app.nidaw.com
ENABLE_DEVTOOLS=false

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
FEATURE_AUTONOMOUS_VEHICLES=false
FEATURE_DRONE_DELIVERY=false
FEATURE_INTERNAL_LEDGER=false
FEATURE_FEDERATED_LEARNING=true
FEATURE_AR_NAVIGATION=true
FEATURE_VOICE_COMMANDS=true
FEATURE_MULTI_LANGUAGE=false
FEATURE_DARK_MODE=true

# ----------------------------------------------------------------------------
# MONITORING
# ----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
GRAFANA_URL=https://staging-grafana.nidaw.com
JAEGER_ENDPOINT=https://staging-jaeger.nidaw.com/api/traces
LOKI_URL=https://staging-loki.nidaw.com
ALERTMANAGER_URL=http://nidaw-staging-alertmanager:9093

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ORIGINS=https://staging-app.nidaw.com,https://staging-admin.nidaw.com
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=500
RATE_LIMIT_BURST=50

# ----------------------------------------------------------------------------
# CACHE
# ----------------------------------------------------------------------------
CACHE_TTL=300
CACHE_MAX_SIZE=5000
CACHE_WARMING_ENABLED=true

# ----------------------------------------------------------------------------
# BACKUP
# ----------------------------------------------------------------------------
BACKUP_DIR=/backups/nidaw/staging
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_S3_BUCKET=nidaw-backups-staging
BACKUP_S3_REGION=us-east-1

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
ENFORCE_HTTPS=true
ENABLE_WAF=true
ENABLE_DDOS_PROTECTION=true
ENABLE_AUDIT_LOGGING=true