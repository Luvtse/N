# ============================================================================
# NIDAW Development Environment Configuration
# ============================================================================
# This file contains development-specific environment variables.
# DO NOT use these values in staging or production!
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=development
REGION=us-east-1
LOG_LEVEL=debug
LOG_FORMAT=console
ENABLE_PROFILING=true
ENABLE_DEBUG=true

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=nidaw
DB_PASSWORD=nidaw_dev
DB_NAME=nidaw
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s
DB_QUERY_TIMEOUT=30s
DB_LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# TIMESCALEDB
# ----------------------------------------------------------------------------
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=nidaw
TIMESCALE_PASSWORD=nidaw_dev
TIMESCALE_DB=nidaw_timeseries

# ----------------------------------------------------------------------------
# REDIS
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_MAX_MEMORY=256mb

# ----------------------------------------------------------------------------
# KAFKA
# ----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8082
KAFKA_CONSUMER_GROUP=nidaw-backend-dev
KAFKA_PRODUCER_TIMEOUT=10s
KAFKA_CONSUMER_TIMEOUT=30s
KAFKA_RETRIES=3
KAFKA_AUTO_CREATE_TOPICS=true

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
JWT_ISSUER=nidaw-dev
JWT_AUDIENCE=nidaw-client-dev
BCRYPT_COST=10
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION=5m

# ----------------------------------------------------------------------------
# PAYMENTS (Stripe Test Mode)
# ----------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_51ABC123DEF456GHI789
STRIPE_WEBHOOK_SECRET=whsec_test_abc123def456
STRIPE_PUBLISHABLE_KEY=pk_test_abc123def456

# ----------------------------------------------------------------------------
# EXTERNAL APIS (Test Keys)
# ----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSyDevTestKey123456789
TWILIO_ACCOUNT_SID=ACdevtest123456789
TWILIO_AUTH_TOKEN=devtestauthtoken123456789
TWILIO_FROM_NUMBER=+15551234567
SENDGRID_API_KEY=SG.devtest123456789
FIREBASE_PROJECT_ID=nidaw-dev
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nDEV\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dev@nidaw-dev.iam.gserviceaccount.com

# ----------------------------------------------------------------------------
# ML PLATFORM
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
FEATURE_STORE_PATH=./ml/feature_store/feast/feature_repo
MODEL_REGISTRY_URL=http://localhost:5000
ML_INFERENCE_TIMEOUT=10s
FEAST_SERVING_URL=http://localhost:6566

# ----------------------------------------------------------------------------
# API GATEWAY
# ----------------------------------------------------------------------------
KONG_PROXY_URL=http://localhost:8000
KONG_ADMIN_URL=http://localhost:8001
KONG_STATUS_URL=http://localhost:8100

# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080/ws
FRONTEND_URL=http://localhost:3000
ENABLE_DEVTOOLS=true

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
FEATURE_AUTONOMOUS_VEHICLES=false
FEATURE_DRONE_DELIVERY=false
FEATURE_BLOCKCHAIN_PAYMENTS=true
FEATURE_FEDERATED_LEARNING=false
FEATURE_AR_NAVIGATION=true
FEATURE_VOICE_COMMANDS=true
FEATURE_MULTI_LANGUAGE=false
FEATURE_DARK_MODE=true

# ----------------------------------------------------------------------------
# MONITORING
# ----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
GRAFANA_URL=http://localhost:3001
JAEGER_ENDPOINT=http://localhost:14268/api/traces
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# ----------------------------------------------------------------------------
# CACHE
# ----------------------------------------------------------------------------
CACHE_TTL=300
CACHE_MAX_SIZE=1000
CACHE_WARMING_ENABLED=true

# ----------------------------------------------------------------------------
# BACKUP
# ----------------------------------------------------------------------------
BACKUP_DIR=/tmp/nidaw-backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_ENABLED=false

# ----------------------------------------------------------------------------
# TESTING
# ----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://nidaw:nidaw_dev@localhost:5432/nidaw_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_KAFKA_BROKERS=localhost:29092
TEST_TIMEOUT=30s

# ----------------------------------------------------------------------------
# DEVELOPER TOOLS
# ----------------------------------------------------------------------------
ENABLE_SWAGGER=true
ENABLE_PPROF=true
ENABLE_TRACE=true
ENABLE_HOT_RELOAD=true