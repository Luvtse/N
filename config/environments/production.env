# ============================================================================
# NIDAW Production Environment Configuration
# ============================================================================
# ⚠️  CRITICAL: This file contains production environment variables.
# All sensitive values MUST be injected via AWS Secrets Manager or
# environment-specific secrets management.
# 
# NEVER commit actual secrets to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=production
REGION=us-east-1
LOG_LEVEL=warn
LOG_FORMAT=json
ENABLE_PROFILING=false
ENABLE_DEBUG=false

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL - Production)
# ----------------------------------------------------------------------------
DB_HOST=${PROD_DB_HOST}
DB_PORT=5432
DB_USER=${PROD_DB_USER}
DB_PASSWORD=${PROD_DB_PASSWORD}
DB_NAME=nidaw_production
DB_SSLMODE=verify-full
DB_MAX_CONNS=100
DB_MIN_CONNS=20
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s
DB_QUERY_TIMEOUT=30s
DB_LOG_LEVEL=error

# ----------------------------------------------------------------------------
# TIMESCALEDB
# ----------------------------------------------------------------------------
TIMESCALE_HOST=${PROD_TIMESCALE_HOST}
TIMESCALE_PORT=5432
TIMESCALE_USER=${PROD_TIMESCALE_USER}
TIMESCALE_PASSWORD=${PROD_TIMESCALE_PASSWORD}
TIMESCALE_DB=nidaw_production_timeseries

# ----------------------------------------------------------------------------
# REDIS
# ----------------------------------------------------------------------------
REDIS_URL=${PROD_REDIS_URL}
REDIS_PASSWORD=${PROD_REDIS_PASSWORD}
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ----------------------------------------------------------------------------
# KAFKA
# ----------------------------------------------------------------------------
KAFKA_BROKERS=${PROD_KAFKA_BROKERS}
SCHEMA_REGISTRY_URL=${PROD_SCHEMA_REGISTRY_URL}
KAFKA_CONSUMER_GROUP=nidaw-backend-production
KAFKA_PRODUCER_TIMEOUT=10s
KAFKA_CONSUMER_TIMEOUT=30s
KAFKA_RETRIES=5

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
JWT_SECRET=${PROD_JWT_SECRET}
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
JWT_ISSUER=nidaw
JWT_AUDIENCE=nidaw-client
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# ----------------------------------------------------------------------------
# PAYMENTS (Stripe Live Mode)
# ----------------------------------------------------------------------------
STRIPE_API_KEY=${PROD_STRIPE_API_KEY}
STRIPE_WEBHOOK_SECRET=${PROD_STRIPE_WEBHOOK_SECRET}
STRIPE_PUBLISHABLE_KEY=${PROD_STRIPE_PUBLISHABLE_KEY}

# ----------------------------------------------------------------------------
# EXTERNAL APIS
# ----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=${PROD_GOOGLE_MAPS_API_KEY}
TWILIO_ACCOUNT_SID=${PROD_TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${PROD_TWILIO_AUTH_TOKEN}
TWILIO_FROM_NUMBER=+1800NIDAW01
SENDGRID_API_KEY=${PROD_SENDGRID_API_KEY}
FIREBASE_PROJECT_ID=nidaw-production
FIREBASE_PRIVATE_KEY=${PROD_FIREBASE_PRIVATE_KEY}
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-prod@nidaw-production.iam.gserviceaccount.com

# ----------------------------------------------------------------------------
# ML PLATFORM
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=${PROD_MLFLOW_URI}
FEATURE_STORE_PATH=/app/ml/feature_store
MODEL_REGISTRY_URL=${PROD_MLFLOW_URI}
ML_INFERENCE_TIMEOUT=5s
FEAST_SERVING_URL=${PROD_FEAST_URL}

# ----------------------------------------------------------------------------
# API GATEWAY
# ----------------------------------------------------------------------------
KONG_PROXY_URL=https://api.nidaw.com
KONG_ADMIN_URL=${PROD_KONG_ADMIN_URL}
KONG_STATUS_URL=${PROD_KONG_STATUS_URL}

# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------
API_BASE_URL=https://api.nidaw.com
WS_BASE_URL=wss://api.nidaw.com/ws
FRONTEND_URL=https://app.nidaw.com
ENABLE_DEVTOOLS=false

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
FEATURE_AUTONOMOUS_VEHICLES=true
FEATURE_DRONE_DELIVERY=true
FEATURE_BLOCKCHAIN_PAYMENTS=true
FEATURE_FEDERATED_LEARNING=true
FEATURE_AR_NAVIGATION=true
FEATURE_VOICE_COMMANDS=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_DARK_MODE=true

# ----------------------------------------------------------------------------
# MONITORING
# ----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
GRAFANA_URL=https://grafana.nidaw.com
JAEGER_ENDPOINT=https://jaeger.nidaw.com/api/traces
LOKI_URL=https://loki.nidaw.com
ALERTMANAGER_URL=${PROD_ALERTMANAGER_URL}
PAGERDUTY_SERVICE_KEY=${PROD_PAGERDUTY_KEY}

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ORIGINS=https://app.nidaw.com,https://admin.nidaw.com,https://partner.nidaw.com
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# ----------------------------------------------------------------------------
# CACHE
# ----------------------------------------------------------------------------
CACHE_TTL=300
CACHE_MAX_SIZE=10000
CACHE_WARMING_ENABLED=true

# ----------------------------------------------------------------------------
# BACKUP
# ----------------------------------------------------------------------------
BACKUP_DIR=/backups/nidaw/production
BACKUP_RETENTION_DAYS=35
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_S3_BUCKET=nidaw-backups-production
BACKUP_S3_REGION=us-east-1
BACKUP_CROSS_REGION_REPLICATION=true
BACKUP_DR_REGION=eu-west-1

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
ENFORCE_HTTPS=true
ENABLE_WAF=true
ENABLE_DDOS_PROTECTION=true
ENABLE_AUDIT_LOGGING=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
ENABLE_CSP=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:; connect-src 'self' https://api.nidaw.com wss://api.nidaw.com

# ----------------------------------------------------------------------------
# COMPLIANCE
# ----------------------------------------------------------------------------
GDPR_COMPLIANT=true
CCPA_COMPLIANT=true
PCI_DSS_COMPLIANT=true
SOC2_COMPLIANT=true
DATA_RETENTION_YEARS=7
AUDIT_LOG_RETENTION_YEARS=7

# ----------------------------------------------------------------------------
# MULTI-REGION
# ----------------------------------------------------------------------------
PRIMARY_REGION=us-east-1
SECONDARY_REGION=eu-west-1
TERTIARY_REGION=ap-southeast-1
FAILOVER_ENABLED=true
FAILOVER_THRESHOLD=3
FAILOVER_TIMEOUT=30s
CROSS_REGION_REPLICATION=true