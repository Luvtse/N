        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-12T00:00:00Z",
          "expires": null,
          "description": "\u00a72.1 optional machine translation for chat (LibreTranslate via CHAT_TRANSLATE_ENDPOINT). Requires chat=true. Kill switch: FEATURE_CHAT_TRANSLATION=false (env) or unset CHAT_TRANSLATE_ENDPOINT; messages then ship untranslated with translated_from=null and the UI hides translation affordances \u2014 never a fake translation. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set the paired FEATURE_* env var to false and redeploy; routes unmount at next boot. Persisted rows remain queryable directly."
        }
      },
      "masked_calling": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-13T00:00:00Z",
          "expires": null,
          "description": "\u00a72.2 masked/anonymous calling (GET /api/v1/telephony/rides/{rideId}/contact, Twilio Proxy adapter). Kill switch: FEATURE_MASKED_CALLING=false (env) unmounts routes and stops new proxy provisioning at next boot; existing sessions expire by TTL. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_MASKED_CALLING=false and redeploy; the route group is not mounted and the sweeper does not start. Live proxy sessions age out via their own TTL."
        }
      },
      "pre_selfie": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
