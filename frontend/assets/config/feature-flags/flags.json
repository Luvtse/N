        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-13T00:00:00Z",
          "expires": null,
          "description": "\u00a72.3 pre-selfie verification (POST /api/v1/driver/rides/{rideId}/pre-selfie + signed-URL redemption GET /api/v1/selfies/{id}). Kill switch: FEATURE_PRE_SELFIE=false (env) unmounts routes at next boot; driver_pre_selfie_url is omitted from ride DTOs and the rider card shows the honest 'not sent' state. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_PRE_SELFIE=false and redeploy; upload/redemption routes are not mounted and the DTO field is dropped. Stored images remain on disk/object storage for compliance review."
        }
      },
      "split_fare": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-15T00:00:00Z",
          "expires": null,
          "description": "\u00a73.3 split fare (POST/GET /api/v1/nidus/rides/{rideId}/split owner actions + public tokenized POST /api/v1/split/{token}/accept). Kill switch: FEATURE_SPLIT_FARE=false (env) unmounts all three routes at next boot; pending invites remain in Postgres and simply 404 until re-enabled \u2014 no partial state is shown in-app. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_SPLIT_FARE=false and redeploy; SplitSvc stays nil so the route group is not mounted. Accepted-but-unpaid shares are untouched in ride_split_invites."
        }
      },
      "cash_payment": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-19T00:00:00Z",
          "expires": null,
          "description": "\u00a73.1 cash payment option (registry 'cash' method + driver POST /api/v1/nidus/rides/{rideId}/confirm-cash-collection). Kill switch: FEATURE_CASH_PAYMENT=false (backend env) stops accepting cash methods at request time and unmounts the confirm route; the Flutter selector hides the Cash row when this client flag is off. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_CASH_PAYMENT=false and redeploy backend; nidusDeps.CashEnabled becomes false so cash requests are rejected with CASH_DISABLED and the confirm route returns 404. Rides already pending cash collection keep their state in Postgres and settle when the flag is re-enabled."
        }
      },
      "promotions": {
        "enabled": false,
        "rolloutPercentage": 0,
        "targeting": {
          "environments": [
            "development",
            "staging"
          ],
          "regions": [
            "ET"
          ]
        },
        "metadata": {
          "owner": "nidus-team@nidaw.com",
          "created": "2026-10-19T00:00:00Z",
          "expires": null,
          "description": "\u00a73.2 promo codes & coupons (POST /api/v1/promotions/redeem projection + GET /api/v1/promotions/mine + request-time application and receipt-time finalization). Kill switch: FEATURE_PROMOTIONS=false (backend env) unmounts both routes and makes request-time attach fail with PROMOTIONS_DISABLED; the Flutter promo row hides itself when this client flag is off. Default false in production per Global Rule 6.",
          "category": "ride_parity",
          "abTestId": null,
          "killSwitch": "Set FEATURE_PROMOTIONS=false and redeploy; PromoSvc stays nil so routes are not mounted and ApplyAtRequest short-circuits with ErrPromotionsDisabled. Existing redemptions stay ledgered in promo_redemptions untouched."
        }
      }
