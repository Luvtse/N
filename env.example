# ============================================================================
# NIDAW Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=development  # development, staging, production
REGION=us-east-1
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, console

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=nidaw
DB_PASSWORD=your-secure-password-here
DB_NAME=nidaw
DB_SSLMODE=disable  # disable, require, verify-ca, verify-full
DB_MAX_CONNS=50
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s
DB_QUERY_TIMEOUT=30s

# ----------------------------------------------------------------------------
# TIMESCALEDB
# ----------------------------------------------------------------------------
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=nidaw
TIMESCALE_PASSWORD=your-secure-password-here
TIMESCALE_DB=nidaw_timeseries

# ----------------------------------------------------------------------------
# REDIS
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# ----------------------------------------------------------------------------
# KAFKA
# ----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8082
KAFKA_CONSUMER_GROUP=nidaw-backend
KAFKA_PRODUCER_TIMEOUT=10s
KAFKA_CONSUMER_TIMEOUT=30s
KAFKA_RETRIES=3

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-min-32-chars-long-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h  # 7 days
JWT_ISSUER=nidaw
JWT_AUDIENCE=nidaw-client
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# ----------------------------------------------------------------------------
# PAYMENTS (Stripe)
# ----------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
DEFAULT_CURRENCY=USD

# ----------------------------------------------------------------------------
# EXTERNAL APIS
# ----------------------------------------------------------------------------
# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=nidaw-dev
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nidaw-dev.iam.gserviceaccount.com

# ----------------------------------------------------------------------------
# ML PLATFORM
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
FEATURE_STORE_PATH=./ml/feature_store/feast/feature_repo
MODEL_REGISTRY_URL=http://localhost:5000
ML_INFERENCE_TIMEOUT=5s
FEAST_SERVING_URL=http://localhost:6566

# ----------------------------------------------------------------------------
# API GATEWAY (Kong)
# ----------------------------------------------------------------------------
KONG_PROXY_URL=http://localhost:8000
KONG_ADMIN_URL=http://localhost:8001
KONG_STATUS_URL=http://localhost:8100

# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080/ws
FRONTEND_URL=http://localhost:3000
ENABLE_DEVTOOLS=true

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
FEATURE_AUTONOMOUS_VEHICLES=false
FEATURE_DRONE_DELIVERY=false
FEATURE_INTERNAL_LEDGER=false
FEATURE_FEDERATED_LEARNING=false
FEATURE_AR_NAVIGATION=true
FEATURE_VOICE_COMMANDS=true
FEATURE_MULTI_LANGUAGE=false
FEATURE_DARK_MODE=true

# ----------------------------------------------------------------------------
# MONITORING
# ----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
GRAFANA_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_ENDPOINT=http://localhost:14268/api/traces
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093
PAGERDUTY_SERVICE_KEY=your-pagerduty-key

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# ----------------------------------------------------------------------------
# CACHE
# ----------------------------------------------------------------------------
CACHE_TTL=300
CACHE_MAX_SIZE=5000
CACHE_WARMING_ENABLED=true

# ----------------------------------------------------------------------------
# BACKUP
# ----------------------------------------------------------------------------
BACKUP_DIR=/backups/nidaw
BACKUP_RETENTION_DAYS=35
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_S3_BUCKET=nidaw-backups
BACKUP_S3_REGION=us-east-1
BACKUP_ENCRYPTION_KEY=your-encryption-key

# ----------------------------------------------------------------------------
# AWS (Production only)
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# ----------------------------------------------------------------------------
# MULTI-REGION
# ----------------------------------------------------------------------------
PRIMARY_REGION=us-east-1
SECONDARY_REGION=eu-west-1
TERTIARY_REGION=ap-southeast-1
FAILOVER_ENABLED=false

# ----------------------------------------------------------------------------
# INTERNAL LEDGER (Phase D — replaces decommissioned blockchain config)
# ----------------------------------------------------------------------------
FEATURE_INTERNAL_LEDGER=false
LEDGER_AUDIT_SIGNING_KEY_REF=secretsmanager://nidaw/ledger/audit-signing-key

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
ENFORCE_HTTPS=false
ENABLE_WAF=true
ENABLE_DDOS_PROTECTION=true
ENABLE_AUDIT_LOGGING=true
ENABLE_HSTS=false

# ----------------------------------------------------------------------------
# TESTING
# ----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://nidaw:nidaw_dev@localhost:5432/nidaw_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_KAFKA_BROKERS=localhost:29092
TEST_TIMEOUT=30s